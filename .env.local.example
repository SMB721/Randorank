# URL publique du site (utilisee pour le SEO : Open Graph, sitemap, robots.txt)
# En local, laisser tel quel. En production, mettre le vrai domaine (ex. https://myrandorank.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Authentification + base Postgres/PostGIS)
# Recupere ces valeurs dans Project Settings > API sur supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Cle "service_role" (meme page) - secrete, jamais exposee au navigateur.
# Utilisee uniquement par le webhook Stripe pour ecrire dans profiles sans session utilisateur.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# GraphHopper (generation de trace par distance - algorithme round_trip)
# Cle gratuite : graphhopper.com/dashboard (onglet API keys)
GRAPHHOPPER_API_KEY=

# Stripe (offre Premium, mensuel + annuel, essai 5 jours)
# Cles API : Developers > API keys sur dashboard.stripe.com (utiliser les cles de test en dev)
STRIPE_SECRET_KEY=
# Secret de signature du webhook : Developers > Webhooks (ou affiche par `stripe listen` en local)
STRIPE_WEBHOOK_SECRET=

# Price ID de chaque produit recurrent (Developers > Product catalog)
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_YEARLY=
